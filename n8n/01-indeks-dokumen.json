      "id": "a1000001-0000-4000-8000-000000000004",
      "name": "Ekstrak Teks",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        720,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const MAKS = 1200; // karakter maksimum per bagian\nconst TUMPANG = 150; // karakter yang diulang di bagian berikutnya\nconst masuk = $input.all().map(i => i.json);\nconst mentah = masuk.length === 1\n  ? (Array.isArray(masuk[0].text) ? masuk[0].text : [masuk[0].text])\n  : masuk.map(i => i.text);\nconst adaHalaman = masuk.length > 1 || Array.isArray(masuk[0].text);\nconst jumlahHalaman = masuk[0].numpages ?? (adaHalaman ? mentah.length : null);\nconst bagian = [];\nlet nomor = 1;\nmentah.forEach((t, i) => {\n  const teks = String(t ?? '').replace(/\\s+/g, ' ').trim();\n  if (!teks) return;\n  const halaman = adaHalaman ? i + 1 : null;\n  let mulai = 0;\n  while (mulai < teks.length) {\n    let akhir = Math.min(mulai + MAKS, teks.length);\n    if (akhir < teks.length) {\n      const spasi = teks.lastIndexOf(' ', akhir);\n      if (spasi > mulai + MAKS / 2) akhir = spasi; // potong di batas kata\n    }\n    const potongan = teks.slice(mulai, akhir).trim();\n    if (potongan.length >= 30) bagian.push({ nomor_bagian: nomor++, halaman, teks: potongan });\n    if (akhir >= teks.length) break;\n    mulai = akhir - TUMPANG;\n  }\n});\nif (bagian.length === 0) {\n  return [{ json: { status: 'gagal', pesan: 'PDF tidak berisi teks (mungkin hasil scan atau foto)', jumlah_halaman: jumlahHalaman, bagian: [] } }];\n}\nreturn [{ json: { status: 'terindeks', pesan: null, jumlah_halaman: jumlahHalaman, bagian } }];"
      },
