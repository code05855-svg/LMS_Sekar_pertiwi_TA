APP_NAME="LMS SMP Sekar Pertiwi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lms-sekolah.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL Laragon: user root, password kosong) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_sekolah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# --- Antrean ---
# sync     : tanpa terminal tambahan (cocok untuk pengembangan dan demo).
# database : jalankan "php artisan queue:work" di terminal kedua (cocok untuk hosting).
QUEUE_CONNECTION=sync

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# --- Akun admin pertama (dibaca AdminSeeder) ---
ADMIN_NOMOR_INDUK=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# --- Integrasi n8n + Gemini (lihat README bagian n8n) ---
# Buat dua string acak berbeda:  php -r "echo bin2hex(random_bytes(32));"
N8N_API_TOKEN=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_INDEKS=http://localhost:5678/webhook/indeks-dokumen
N8N_WEBHOOK_TANYA=http://localhost:5678/webhook/tanya-jawab
N8N_TIMEOUT=60

# --- Batas unggah (KB). Pastikan upload_max_filesize dan post_max_size PHP lebih besar ---
BATAS_UNGGAH_MATERI_KB=20480
BATAS_UNGGAH_TUGAS_KB=10240

# Pengembangan: true = lempar galat bila ada query N+1 (lazy loading)
LMS_CEGAH_LAZY_LOADING=false
